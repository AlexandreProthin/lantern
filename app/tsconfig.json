{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "bundler",
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "strict": true, "verbatimModuleSyntax": true, "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "*.ts", "evals/**/*.ts", "tests/**/*.ts", "demo/**/*.ts"]
}
