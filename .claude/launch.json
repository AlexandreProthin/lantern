{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lantern-poc-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "poc",
        "run",
        "dev"
      ],
      "port": 1430
    },
    {
      "name": "lantern-app-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev"
      ],
      "port": 1431
    },
    {
      "name": "specs-workshop",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "agent_design/tool/specs_work/serve.py",
        "--no-open",
        "--port",
        "8770"
      ],
      "port": 8770
    },
    {
      "name": "design-workflow",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "agent_design/tool/workflow.py",
        "serve",
        "--no-open",
        "--port",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "identity-review",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8780",
        "--bind",
        "127.0.0.1",
        "--directory",
        "agent_identity"
      ],
      "port": 8780
    }
  ]
}