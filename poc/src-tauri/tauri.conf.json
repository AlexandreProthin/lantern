{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lantern",
  "version": "0.0.0",
  "identifier": "io.github.alexandreprothin.lantern",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Lantern (PoC)", "width": 1360, "height": 860, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
